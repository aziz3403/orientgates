# Copy to .env.local (gitignored). Never commit the real values.

# Password for the /admin UI. Pick something long and unique.
ADMIN_PASSWORD=change-me-to-something-long

# Signs the admin session cookie. Use a long random string, independent of
# the password (e.g. `openssl rand -hex 32`). Falls back to ADMIN_PASSWORD
# if unset, but setting it is strongly recommended.
ADMIN_SESSION_SECRET=

# Optional: only needed if you run scripts/export-from-supabase.mjs
# to refresh data/products-export.json from the live Supabase DB.
# Generate at https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=rtdxmomppohpvyiewfyh
